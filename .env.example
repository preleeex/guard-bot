# ----------------------------------------------------------------------------
# Backend (bot/) environment. Copy to bot/.env and fill in.
# ----------------------------------------------------------------------------

# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF...
# Bot username without @ (used to build t.me deep links)
BOT_USERNAME=YourGuardBot

# Bot operator (unlimited groups + admin view). From the spec.
OWNER_USER_ID=7210276147
# System/business events log chat id. From the spec.
# NOTE: for supergroups this is usually the -100... prefixed id. Verify with getUpdates.
SYSTEM_LOG_CHAT_ID=3275669277

# Secret token sent by Telegram in the X-Telegram-Bot-Api-Secret-Token header.
# Generate a long random string and pass the same value to setWebhook.
WEBHOOK_SECRET_TOKEN=change-me-to-a-long-random-string

# Public HTTPS base URL of THIS backend (DigitalOcean app). No trailing slash.
PUBLIC_BASE_URL=https://your-bot.ondigitalocean.app
# Public URL of the Mini App (Vercel). No trailing slash.
MINI_APP_URL=https://your-webapp.vercel.app

# PostgreSQL connection string (DigitalOcean Managed Postgres)
DATABASE_URL=postgresql://user:password@host:25060/defaultdb?sslmode=require

# Crypto Pay API (@CryptoBot). Use the testnet base for testing.
CRYPTO_PAY_API_TOKEN=
CRYPTO_PAY_API_BASE=https://pay.crypt.bot/api
# Testnet: https://testnet-pay.crypt.bot/api

# HTTP port for the backend
PORT=8080

# ----------------------------------------------------------------------------
# Frontend (webapp/) environment. Set in Vercel project settings.
# ----------------------------------------------------------------------------
# Base URL of the backend REST API (usually PUBLIC_BASE_URL above)
NEXT_PUBLIC_API_BASE_URL=https://your-bot.ondigitalocean.app
